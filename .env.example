# Copy this file to .env and fill in local values.
# Do not commit .env or any real credentials.

# Gemini (client bundle — still visible in the browser; rotate if previously committed)
REACT_APP_GEMINI_API_KEY=

# EmailJS (public-by-design client IDs; restrict allowed origins in the EmailJS dashboard)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Optional: path to a local Firebase service-account JSON for tools/setAdminClaim.js
# Do not place this JSON in the repo.
SERVICE_ACCOUNT_PATH=
